# Isolate NeMo's static GGML copy and expose only its stable C ABI.
function(hearth_finalize_magpie)
    if(TARGET nemo_speech_tts)
        set_target_properties(nemo_speech_tts PROPERTIES OUTPUT_NAME hearth_magpie SOVERSION "" VERSION "")
        get_target_property(options nemo_speech_tts LINK_OPTIONS)
        if(NOT options)
            set(options "")
        endif()
        list(FILTER options EXCLUDE REGEX "version-script")
        if(ANDROID)
            list(APPEND options "-Wl,--version-script=${CMAKE_CURRENT_FUNCTION_LIST_DIR}/magpie.map" "-Wl,--exclude-libs,ALL" "-Wl,-z,max-page-size=16384")
        endif()
        set_target_properties(nemo_speech_tts PROPERTIES LINK_OPTIONS "${options}")
    endif()
endfunction()
cmake_language(DEFER CALL hearth_finalize_magpie)
