cmake_minimum_required(VERSION 3.26)
project(hearth_owsm LANGUAGES C CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_C_VISIBILITY_PRESET hidden)
set(CMAKE_CXX_VISIBILITY_PRESET hidden)
set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(AUDIOCPP_MODEL_SET custom CACHE STRING "" FORCE)
set(AUDIOCPP_MODELS owsm CACHE STRING "" FORCE)
foreach(flag CUDA HIP VULKAN METAL LLAMAFILE RKNN NEON NATIVE_CPU OPENMP CPU_ALL_VARIANTS BUILD_EXAMPLES BUILD_TESTS BUILD_EXTENDED_TESTS BUILD_MODEL_TESTS BUILD_WARMBENCH)
  set(ENGINE_ENABLE_${flag} OFF CACHE BOOL "" FORCE)
endforeach()
foreach(flag EXAMPLES TESTS EXTENDED_TESTS MODEL_TESTS WARMBENCH)
  set(ENGINE_BUILD_${flag} OFF CACHE BOOL "" FORCE)
endforeach()
set(AUDIOCPP_BUILD_NATIVE_MODEL_MANAGER OFF CACHE BOOL "" FORCE)
set(AUDIOCPP_BUILD_C_API OFF CACHE BOOL "" FORCE)
set(AUDIOCPP_USE_SYSTEM_OPENSSL OFF CACHE BOOL "" FORCE)
set(AUDIOCPP_DEPLOYMENT_BUILD ON CACHE BOOL "" FORCE)
set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
set(GGML_BLAS OFF CACHE BOOL "" FORCE)
set(GGML_ACCELERATE OFF CACHE BOOL "" FORCE)
add_subdirectory("${AUDIOCPP_SOURCE}" audio EXCLUDE_FROM_ALL)
get_target_property(owsm_sources engine_model_owsm SOURCES)
list(FILTER owsm_sources EXCLUDE REGEX "src/models/owsm/(assets|runtime)\\.cpp$")
set_property(TARGET engine_model_owsm PROPERTY SOURCES "${owsm_sources}")
target_sources(engine_model_owsm PRIVATE "${OWSM_PREPARED}/owsm-assets.cpp" "${OWSM_PREPARED}/owsm-runtime.cpp")
get_target_property(core_sources engine_core SOURCES)
list(FILTER core_sources EXCLUDE REGEX "src/framework/assets/tensor_source\\.cpp$")
set_property(TARGET engine_core PROPERTY SOURCES "${core_sources}")
target_sources(engine_core PRIVATE "${OWSM_PREPARED}/owsm-tensor-source.cpp")
add_library(hearth_owsm SHARED "${HEARTH_CPP}/speech/modern_cpu/owsm_backend.cpp" "${AUDIOCPP_SOURCE}/src/capi/audiocpp.cpp")
target_include_directories(hearth_owsm PRIVATE "${AUDIOCPP_SOURCE}/include")
target_compile_definitions(hearth_owsm PRIVATE AUDIOCPP_VERSION_STRING="hearth-owsm-pinned")
target_link_libraries(hearth_owsm PRIVATE engine_runtime ggml)
if(ANDROID)
  target_link_libraries(hearth_owsm PRIVATE log android)
  target_link_options(hearth_owsm PRIVATE "-Wl,-z,max-page-size=16384" "-Wl,--exclude-libs,ALL" "-Wl,--version-script=${HEARTH_CPP}/speech/modern_cpu/owsm.map")
elseif(APPLE)
  target_link_options(hearth_owsm PRIVATE "-Wl,-exported_symbol,_hearth_owsm_backend_v1")
endif()
