cmake_minimum_required(VERSION 3.26)
project(hearth_audar LANGUAGES C CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_C_VISIBILITY_PRESET hidden)
set(CMAKE_CXX_VISIBILITY_PRESET hidden)
set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
foreach(option BACKEND_DL CPU_ALL_VARIANTS NATIVE OPENMP METAL BLAS ACCELERATE CUDA VULKAN OPENCL CPU_KLEIDIAI)
 set(GGML_${option} OFF CACHE BOOL "" FORCE)
endforeach()
foreach(option BUILD_TESTS BUILD_EXAMPLES BUILD_TOOLS BUILD_SERVER CURL OPENSSL SUBPROCESS)
 set(LLAMA_${option} OFF CACHE BOOL "" FORCE)
endforeach()
set(MTMD_VIDEO OFF CACHE BOOL "" FORCE)
add_subdirectory("${LLAMA_SOURCE}" llama EXCLUDE_FROM_ALL)
add_subdirectory("${LLAMA_SOURCE}/tools/mtmd" mtmd EXCLUDE_FROM_ALL)
add_library(hearth_audar SHARED "${HEARTH_CPP}/speech/modern_cpu/audar_backend.cpp")
target_link_libraries(hearth_audar PRIVATE llama mtmd ggml-cpu)
if(ANDROID)
 target_link_libraries(hearth_audar PRIVATE log android)
 target_link_options(hearth_audar PRIVATE "-Wl,-z,max-page-size=16384" "-Wl,--exclude-libs,ALL" "-Wl,--version-script=${HEARTH_CPP}/speech/modern_cpu/audar.map")
elseif(APPLE)
 target_link_options(hearth_audar PRIVATE "-Wl,-exported_symbol,_hearth_audar_backend_v1")
endif()
