cmake_minimum_required(VERSION 3.26)
project(hearth_transcribe_cpp LANGUAGES C CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
foreach(option BACKEND_DL CPU_ALL_VARIANTS NATIVE OPENMP METAL BLAS ACCELERATE CUDA VULKAN OPENCL CPU_KLEIDIAI)
  set(GGML_${option} OFF CACHE BOOL "" FORCE)
endforeach()
foreach(option BUILD_SHARED BUILD_TESTS BUILD_EXAMPLES BUILD_TOOLS ENABLE_VALIDATION_HOOKS USE_OPENMP USE_SYSTEM_BLAS METAL CUDA HIP GGML_BACKEND_DL)
  set(TRANSCRIBE_${option} OFF CACHE BOOL "" FORCE)
endforeach()
set(GGML_CCACHE OFF CACHE BOOL "" FORCE)
set(HEARTH_SPEECH_ACCELERATION "cpu" CACHE STRING "Explicit compute backend")
set(HEARTH_TARGET hearth_transcribe_cpp)
if(HEARTH_SPEECH_ACCELERATION STREQUAL "vulkan")
  set(TRANSCRIBE_VULKAN ON CACHE BOOL "" FORCE)
  set(HEARTH_TARGET hearth_transcribe_cpp_vulkan)
elseif(NOT HEARTH_SPEECH_ACCELERATION STREQUAL "cpu")
  message(FATAL_ERROR "Only CPU and explicit Vulkan are supported")
endif()
add_subdirectory("${TRANSCRIBE_SOURCE}" transcribe)
# Upstream uses CMAKE_SOURCE_DIR for this public include when nested.
target_include_directories(transcribe PUBLIC "${TRANSCRIBE_SOURCE}/include")
if(HEARTH_SPEECH_ACCELERATION STREQUAL "vulkan")
  target_include_directories(ggml-vulkan PRIVATE "${HEARTH_SPIRV_HEADERS}")
endif()
add_library(${HEARTH_TARGET} SHARED "${HEARTH_CPP}/speech/expansion/transcribe_cpp_backend.cpp")
target_compile_definitions(${HEARTH_TARGET} PRIVATE HEARTH_TRANSCRIBE_ACCELERATION="${HEARTH_SPEECH_ACCELERATION}")
target_link_libraries(${HEARTH_TARGET} PRIVATE transcribe)
if(ANDROID)
  target_link_libraries(${HEARTH_TARGET} PRIVATE log android)
  target_link_options(${HEARTH_TARGET} PRIVATE "-Wl,-z,max-page-size=16384" "-Wl,--exclude-libs,ALL"
    "-Wl,--version-script=${HEARTH_CPP}/speech/expansion/exports.map")
elseif(APPLE)
  target_link_options(${HEARTH_TARGET} PRIVATE "-Wl,-exported_symbol,_hearth_cohere_backend_v1"
    "-Wl,-exported_symbol,_hearth_funasr_backend_v1" "-Wl,-exported_symbol,_hearth_voxtral_backend_v1")
endif()
