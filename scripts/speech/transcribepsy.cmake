cmake_minimum_required(VERSION 3.26)
project(hearth_transcribepsy LANGUAGES C CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
foreach(option BACKEND_DL CPU_ALL_VARIANTS NATIVE OPENMP METAL BLAS ACCELERATE CUDA VULKAN OPENCL CPU_KLEIDIAI)
  set(GGML_${option} OFF CACHE BOOL "" FORCE)
endforeach()
set(PARAKEET_OPENMP OFF CACHE BOOL "" FORCE)
set(PARAKEET_BUILD_EXECUTABLES OFF CACHE BOOL "" FORCE)
set(PARAKEET_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(PARAKEET_INSTALL OFF CACHE BOOL "" FORCE)
set(PARAKEET_CCACHE OFF CACHE BOOL "" FORCE)
set(GGML_CCACHE OFF CACHE BOOL "" FORCE)
set(HEARTH_SPEECH_ACCELERATION "cpu" CACHE STRING "Explicit optional compute backend")
set(HEARTH_SPEECH_TARGET hearth_transcribepsy)
if(HEARTH_SPEECH_ACCELERATION STREQUAL "vulkan")
  set(GGML_VULKAN ON CACHE BOOL "" FORCE)
  set(HEARTH_SPEECH_TARGET hearth_transcribepsy_vulkan)
elseif(HEARTH_SPEECH_ACCELERATION STREQUAL "opencl")
  set(GGML_OPENCL ON CACHE BOOL "" FORCE)
  set(GGML_OPENCL_EMBED_KERNELS ON CACHE BOOL "" FORCE)
  set(GGML_OPENCL_USE_ADRENO_KERNELS ON CACHE BOOL "" FORCE)
  set(HEARTH_SPEECH_TARGET hearth_transcribepsy_opencl)
  execute_process(COMMAND python3 "${HEARTH_CPP}/../../../../scripts/translation/generate-opencl-shim.py"
    --headers "${HEARTH_OPENCL_HEADERS}"
    --source "${TRANSCRIBEPSY_SOURCE}/ggml/src/ggml-opencl/ggml-opencl.cpp"
    --source "${HEARTH_CPP}/common/opencl_loader.h"
    --output "${CMAKE_BINARY_DIR}/opencl-shim.cpp" COMMAND_ERROR_IS_FATAL ANY)
  add_library(hearth_speech_opencl_driver STATIC "${CMAKE_BINARY_DIR}/opencl-shim.cpp")
  target_include_directories(hearth_speech_opencl_driver PRIVATE "${HEARTH_CPP}/common" "${HEARTH_OPENCL_HEADERS}")
  target_link_libraries(hearth_speech_opencl_driver PRIVATE dl)
  set(OpenCL_LIBRARY hearth_speech_opencl_driver CACHE STRING "Private typed forwarding shim" FORCE)
  set(OpenCL_INCLUDE_DIR "${HEARTH_OPENCL_HEADERS}" CACHE PATH "Pinned Khronos headers" FORCE)
elseif(NOT HEARTH_SPEECH_ACCELERATION STREQUAL "cpu")
  message(FATAL_ERROR "Unsupported speech acceleration")
endif()
add_subdirectory("${TRANSCRIBEPSY_SOURCE}" parakeet)
if(HEARTH_SPEECH_ACCELERATION STREQUAL "vulkan")
  target_include_directories(ggml-vulkan PRIVATE "${HEARTH_SPIRV_HEADERS}")
elseif(HEARTH_SPEECH_ACCELERATION STREQUAL "opencl")
  execute_process(COMMAND python3 "${HEARTH_CPP}/../../../../scripts/translation/patch-opencl-backend.py"
    --source "${TRANSCRIBEPSY_SOURCE}/ggml/src/ggml-opencl/ggml-opencl.cpp"
    --expected-exits 6 --output "${CMAKE_BINARY_DIR}/opencl-patched.cpp" COMMAND_ERROR_IS_FATAL ANY)
  get_target_property(HEARTH_OPENCL_SOURCES ggml-opencl SOURCES)
  list(FILTER HEARTH_OPENCL_SOURCES EXCLUDE REGEX "(^|/)ggml-opencl\\.cpp$")
  set_property(TARGET ggml-opencl PROPERTY SOURCES ${HEARTH_OPENCL_SOURCES} "${CMAKE_BINARY_DIR}/opencl-patched.cpp")
  target_include_directories(ggml-opencl PRIVATE "${TRANSCRIBEPSY_SOURCE}/ggml/src/ggml-opencl")
endif()
add_library(${HEARTH_SPEECH_TARGET} SHARED "${HEARTH_CPP}/speech/backends/transcribepsy_backend.cpp")
target_compile_definitions(${HEARTH_SPEECH_TARGET} PRIVATE HEARTH_TRANSCRIBEPSY_ACCELERATION="${HEARTH_SPEECH_ACCELERATION}")
target_link_libraries(${HEARTH_SPEECH_TARGET} PRIVATE qvac-parakeet)
if(HEARTH_SPEECH_ACCELERATION STREQUAL "opencl")
  target_compile_definitions(${HEARTH_SPEECH_TARGET} PRIVATE HEARTH_TRANSCRIBEPSY_OPENCL=1)
  target_include_directories(${HEARTH_SPEECH_TARGET} PRIVATE "${HEARTH_OPENCL_HEADERS}")
  target_link_libraries(${HEARTH_SPEECH_TARGET} PRIVATE hearth_speech_opencl_driver)
endif()
if(ANDROID)
  target_link_libraries(${HEARTH_SPEECH_TARGET} PRIVATE log android)
  target_link_options(${HEARTH_SPEECH_TARGET} PRIVATE "-Wl,-z,max-page-size=16384" "-Wl,--exclude-libs,ALL"
    "-Wl,--version-script=${HEARTH_CPP}/speech/backends/exports.map")
elseif(APPLE)
  target_link_options(${HEARTH_SPEECH_TARGET} PRIVATE "-Wl,-exported_symbol,_hearth_speech_backend_v1")
endif()
